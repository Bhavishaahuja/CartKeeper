# The app's own key wins over ANTHROPIC_API_KEY, so a host that sets ANTHROPIC_* can't redirect it.
CARTKEEPER_ANTHROPIC_API_KEY=
# CARTKEEPER_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Durable storage for runs paused on approval. Supabase: use the Session pooler URL.
# Without it, a local LibSQL file (CARTKEEPER_MASTRA_DB_URL, default file:./mastra.db) is used.
# DATABASE_URL=postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Tests: also run the restart test against Postgres.
# CARTKEEPER_TEST_DATABASE_URL=postgresql://postgres@localhost:5432/cartkeeper_test
