# Copy to .env and fill in. Never commit .env.
# CARTKEEPER_ANTHROPIC_API_KEY also works and wins (use it in Claude Code cloud environments)
ANTHROPIC_API_KEY=
# low | medium | high | xhigh | max
CARTKEEPER_EFFORT=medium

# Day 3: must start with sk_test_ or rk_test_ (the app refuses to boot otherwise).
# Leave empty to simulate payments in memory.
STRIPE_SECRET_KEY=
# Optional: found automatically. Set only to pin a specific one.
STRIPE_FINANCIAL_ACCOUNT_ID=
STRIPE_CARDHOLDER_ID=

# Day 2+: Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
